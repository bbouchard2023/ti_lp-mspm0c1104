with "config/mspm0c1104_example_config.gpr";
project MSPM0C1104_Example is

	for Source_Dirs use ("src/", "config/");
	for Object_Dir use "obj/" & Mspm0c1104_Example_Config.Build_Profile;
	for Create_Missing_Dirs use "True";
	for Exec_Dir use "bin";
	for Main use ("mspm0c1104_example.adb");
	for Target use "arm-elf";
	for Runtime ("Ada") use "light-cortex-m0p";
	for Languages use ("Ada", "ASM_CPP");

	package Compiler is
	  for Default_Switches ("Ada") use Mspm0c1104_Example_Config.Ada_Compiler_Switches;
	end Compiler;

	package Binder is
	  for Switches ("Ada") use ("-Es"); --  Symbolic traceback
	end Binder;

	package Install is
	  for Artifacts (".") use ("share");
	end Install;

	package Device_Configuration is
		for CPU_Name use "ARM Cortex-M0P";
		for Float_Handling use "soft";
		
		for Number_Of_Interrupts use "32";
		
		for Memories use ("RAM", "FLASH");
		
		for Boot_Memory use "FLASH";
		
		for Mem_Kind ("RAM") use "ram";
		for Address ("RAM") use "0x20000000";
		for Size ("RAM") use "0x400";
		
		for Mem_Kind ("FLASH") use "rom";
		for Address ("FLASH") use "0x00000000";
		for Size ("FLASH") use "0x4000";	
	end	Device_Configuration;
	
	package Linker is
		for Switches ("Ada") use ("-T", Project'Project_dir & "/src/link.ld",
								 "-Wl,--print-memory-usage",
								 "-Wl,--gc-sections");
	end Linker;
end MSPM0C1104_Example;
